# Copy to .env (never commit it). Every variable is optional; the defaults run 100% locally.
CONCIERGE_PROVIDER=ollama               # ollama | gemini | stub
CONCIERGE_MODEL=qwen3:4b                # gemini-3.5-flash for gemini
OLLAMA_HOST=http://127.0.0.1:11434      # loopback only unless the next line is 1
CONCIERGE_ALLOW_REMOTE_OLLAMA=
CONCIERGE_MEMORY=local                  # local | vertex | inmemory
CONCIERGE_MEMORY_DB=                    # default ~/.cache/travel-concierge/memory.sqlite3
CONCIERGE_EXTRACTOR=                    # llm | rules (default: llm, rules for the stub)
CONCIERGE_MEMORY_TTL_DAYS=365           # 0 = never expire
CONCIERGE_MEMORY_TOP_K=10
# Only for CONCIERGE_MEMORY=vertex - a PAID Google Cloud service, your project, your bill.
# See docs/vertex-setup.md. Credentials come from `gcloud auth application-default login`.
# CONCIERGE_VERTEX_PROJECT=
# CONCIERGE_VERTEX_LOCATION=us-central1
# CONCIERGE_VERTEX_AGENT_ENGINE_ID=
# Only for the optional Gemini provider (your key, your bill):
# GOOGLE_API_KEY=
